; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PetCar"
config/version="1.0.0"
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.60784316, 0.7372549, 0.05882353, 1)
boot_splash/use_filter=false
boot_splash/image="uid://duxprf1gtod7r"
config/icon="uid://bdpms451sss71"
boot_splash/minimum_display_time=1000

[audio]

buses/default_bus_layout="uid://1e7hw7uf0esq"

[autoload]

SoundManager="*uid://t3888i30cs5o"
ScreenshotTool="*uid://ymqm1iouveub"
Settings="*uid://bdg0vgy8jekpm"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/size/borderless=true
window/size/transparent=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[input]

take_screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":true,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":84,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://localization/text.en.translation", "res://localization/text.es.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
